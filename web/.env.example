# Base URL of the Rust API as reached from the server (Server Components, Route
# Handlers, Server Actions). Used by /api/openapi to fetch the OpenAPI document
# and by lib/api on the server. Must match API_PORT in ../api/.env.
API_URL=http://localhost:8080

# Base URL of the Rust API as reached from the browser. Inlined into the client
# bundle at build time, so it must be publicly resolvable and must be listed in
# the API's CORS_ALLOWED_ORIGINS counterpart (see ../api/.env.template).
NEXT_PUBLIC_API_URL=http://localhost:8080
