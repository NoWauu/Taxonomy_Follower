DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taxonomy_follower

# --- Server -------------------------------------------------------------
# Port the API listens on. Keep it off 3000, which the Next.js dev server takes.
API_PORT=8080
# Base URL the browser reaches the API at. Published as the `servers` entry of
# the OpenAPI document, which is what Swagger UI's "Try it out" calls.
PUBLIC_API_URL=http://localhost:8080

# --- Auth ---------------------------------------------------------------
# Signing secret for access tokens. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600

# Public base URL of the web app. Password reset links point at
# <APP_URL>/reset-password?token=...
APP_URL=http://localhost:3000

# Browser origins allowed to call the API. Defaults to APP_URL; set this to a
# comma separated list when more than one front end needs access.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Routing ------------------------------------------------------------
# Itineraries between the departure, the stops and the arrival of a trip.
# Leave MAPBOX_ACCESS_TOKEN empty to disable real routing: distances become
# straight lines and durations a flat average speed, flagged `estimated` in the
# response. Fine for local development, useless for a real user.
# Get a token at https://account.mapbox.com/access-tokens/ ; a public `pk.`
# token scoped to Directions is enough, since the call is server side.
MAPBOX_ACCESS_TOKEN=
# Root of the Directions API. Only worth changing to aim at a stub in tests.
MAPBOX_BASE_URL=https://api.mapbox.com
# driving-traffic (max 3 waypoints) | driving | walking | cycling
ROUTING_PROFILE=driving
# Budget for a single routing call, in seconds.
ROUTING_TIMEOUT_SECONDS=10

# --- Mail ---------------------------------------------------------------
# Leave SMTP_HOST empty to disable delivery: emails are written to the logs
# instead, which is what you want for local development.
SMTP_HOST=
# tls (implicit, :465) | starttls (:587) | none (:25, dev relays only)
SMTP_ENCRYPTION=starttls
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Taxonomy Follower <no-reply@localhost>
